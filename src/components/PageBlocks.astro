---
// Herbruikbare render van de page-builder-blokken
// (richtext / image / quote). Eén bron voor de-boerderij, soepmobiel, vind-ons.
// De styling (.figure-inline / .pull-quote) staat hieronder zodat ze meekomt
// waar de component ook gebruikt wordt; .prose erft van global.css.
import type { PageBlock } from '@lib/content';

interface Props {
  blocks?: PageBlock[];
}

const { blocks = [] } = Astro.props;
---

{blocks.map((block) => {
  if (block.type === 'richtext') {
    return <div class="prose" set:html={block.content} />;
  }
  if (block.type === 'image') {
    return (
      <figure class={`figure-inline figure--${block.layout}`}>
        <img src={block.src} alt={block.caption ?? ''} />
        {block.caption && <figcaption>{block.caption}</figcaption>}
      </figure>
    );
  }
  if (block.type === 'quote') {
    return (
      <blockquote class="pull-quote">
        {block.text}
        {block.attribution && <cite>{block.attribution}</cite>}
      </blockquote>
    );
  }
  return null;
})}

<style>
  /* Figuren en prose-blokken centreren op de prose-breedte, net als .prose. */
  .figure-inline {
    max-width: var(--max-w-prose);
    margin: 2.5rem auto;
  }
  .figure-inline img {
    width: 100%;
    border: 1px solid var(--ink);
    background: var(--paper-deep);
    aspect-ratio: 4/3;
    object-fit: cover;
  }
  .figure-inline figcaption {
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--ink-faded);
    text-align: center;
  }
  /* Layout-varianten van het image-blok. */
  .figure--portret {
    float: right;
    max-width: 16rem;
    margin: 0.5rem 0 1.5rem 2rem;
  }
  .figure--breed {
    max-width: 56rem;
  }
  @media (max-width: 640px) {
    .figure--portret {
      float: none;
      max-width: 100%;
      margin: 2rem auto;
    }
  }
  /* Pull-quote: Fraunces-italic met terracotta linkerrand (zoals .prose blockquote). */
  .pull-quote {
    max-width: var(--max-w-prose);
    margin: 2rem auto;
    border-left: 3px solid var(--terracotta);
    padding-left: 1.5rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--ink);
  }
  .pull-quote cite {
    display: block;
    margin-top: 0.75rem;
    font-size: 0.85rem;
    font-style: normal;
    letter-spacing: 0.05em;
    color: var(--ink-faded);
  }
</style>
